<?xml version="1.0" encoding="utf-8"?>
<!--
    SiN purchase-price policy. IDs are canonical <modName>:<relative XML path>
    values discovered from the loaded store catalog. Only entries in this
    file are changed; all other productions retain their source price.
    Source ZIPs are never modified. Capacity remains native because FS25 does
    not expose a safe, authoritative storage-capacity override at this seam.
-->
